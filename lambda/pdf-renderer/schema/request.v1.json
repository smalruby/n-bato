{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://n-bato.smalruby.app/schema/pdf-renderer/request.v1.json",
  "title": "n-bato の PDF を作る Lambda への要求(プロトコル 1。docs/design/pdf-lambda.md 2.3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "request_id", "input_key", "input", "output_prefix", "options", "limits", "deadline_at"],
  "properties": {
    "protocol": { "const": 1 },
    "request_id": { "type": "string", "pattern": "^pdf-[0-9]+-a[0-9]+$", "maxLength": 64 },
    "input_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "key", "sha256", "bytes"],
      "properties": {
        "bucket": { "type": "string", "minLength": 3, "maxLength": 63 },
        "key": { "type": "string", "pattern": "^v1/in/[0-9]+-[0-9a-f]{64}\\.html$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 }
      }
    },
    "output_prefix": { "type": "string", "pattern": "^v1/out/[0-9a-f]{64}/$" },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "print_background", "prefer_css_page_size"],
      "properties": {
        "format": { "enum": ["A4"] },
        "print_background": { "type": "boolean" },
        "prefer_css_page_size": { "type": "boolean" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_pages", "max_output_bytes"],
      "properties": {
        "max_pages": { "type": "integer", "minimum": 1, "maximum": 25 },
        "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 52428800 }
      }
    },
    "deadline_at": { "type": "integer", "minimum": 0 }
  }
}
