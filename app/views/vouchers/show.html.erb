<% content_for :title, "証憑 ##{@voucher.id}" %>
<% crumbs [ "証憑・AI 仕訳", vouchers_path ], "証憑 ##{@voucher.id}" %>
<div class="flex items-center justify-between mb-4">
  <h1 class="page-title mb-0">証憑 #<%= @voucher.id %> <%= render "status_badge", voucher: @voucher %></h1>
  <div class="flex gap-2">
    <%= link_to "編集", edit_voucher_path(@voucher), class: "btn-secondary" %>
    <% if @ai_ready && !@voucher.status.in?(%w[booked proposing]) %>
      <%= button_to(@voucher.journal_proposals.any? ? "AI に提案し直してもらう" : "AI に仕訳を提案してもらう", propose_voucher_path(@voucher), class: "btn") %>
    <% end %>
  </div>
</div>

<% if @voucher.status == "proposing" %>
  <%# 待つ表示(デザインシステム「待つ表示」): 15 秒ごとに読み込み直し、提案ができるまでくり返す。5 分で止める。 %>
  <p class="nb-flash nb-waiting" role="status" data-controller="auto-reload" data-auto-reload-seconds-value="15" data-auto-reload-max-tries-value="20">
    <span data-auto-reload-target="running">AI が仕訳の提案を作っています。<b><span data-auto-reload-target="count">15</span> 秒後</b>に読み込み直します(このままにしておけば、提案ができるまでくり返します)。
      <button type="button" class="nb-btn" data-action="auto-reload#now">いま読み込み直す</button></span>
    <span data-auto-reload-target="stopped" hidden>5 分たっても提案ができていません。時間がかかっているか、AI でエラーが起きた可能性があります。少しあとで、この画面を読み込み直してください。</span>
  </p>
<% end %>
<div class="grid md:grid-cols-2 gap-4 mb-6">
  <div class="card">
    <dl class="grid grid-cols-3 gap-y-2 text-sm">
      <dt class="text-stone-500">種類</dt><dd class="col-span-2"><%= @voucher.kind_label %></dd>
      <dt class="text-stone-500">日付</dt><dd class="col-span-2"><%= @voucher.issued_on && l(@voucher.issued_on) %></dd>
      <dt class="text-stone-500">金額</dt><dd class="col-span-2"><%= yen(@voucher.amount) %></dd>
      <dt class="text-stone-500">説明</dt><dd class="col-span-2 whitespace-pre-wrap"><%= @voucher.description %></dd>
      <dt class="text-stone-500">補足</dt><dd class="col-span-2 whitespace-pre-wrap"><%= @voucher.notes %></dd>
    </dl>
    <% if @voucher.ai_error.present? %><p class="mt-3 text-sm text-red-700">AI エラー: <%= @voucher.ai_error %></p><% end %>
    <% if @voucher.ai_questions.present? %>
      <div class="mt-3 rounded bg-amber-50 border border-amber-200 p-3 text-sm">
        <div class="font-medium mb-1">AI からの確認事項</div>
        <ul class="list-disc pl-5"><% @voucher.ai_questions.lines.each do |q| %><li><%= q %></li><% end %></ul>
        <p class="mt-2 text-stone-600">答えを「補足」に書いて、提案し直してもらえます。</p>
      </div>
    <% end %>
  </div>
  <div class="card">
    <% @voucher.files.each do |file| %>
      <% if file.image? %>
        <%= link_to image_tag(url_for(file), class: "max-h-80 mx-auto mb-2"), url_for(file), target: "_blank", rel: "noopener", title: "別のタブで開く" %>
      <% else %>
        <p><%= new_tab_link_to file.filename.to_s, url_for(file), class: "underline" %></p>
      <% end %>
    <% end %>
    <% if @voucher.files.empty? %><p class="text-stone-500 text-sm">ファイルなし</p><% end %>
  </div>
</div>

<h2 class="section-title" id="proposals">AI の仕訳提案</h2>
<% if @proposals.empty? %>
  <p class="text-stone-500 text-sm mb-4">まだ提案はありません。<%= link_to "自分で仕訳を入力する", new_journal_entry_path, class: "underline" %></p>
<% end %>
<%# 科目・部門の選択肢は、提案の日付の年度のものにする(年度ごとに科目の行が違うため。証憑の日付の年度では、別の年度の提案の科目が選択肢に無く、先頭の「現金」が選ばれてしまう)。 %>
<% @proposals.each do |p| %>
  <% p_year = p.entry_date ? FiscalYear.for(p.entry_date).year : Current.working_year %>
  <% accounts = Account.in_year(p_year).ordered.map { |a| [ a.to_s, a.id ] } %>
  <% departments = Department.in_year(p_year).ordered.map { |d| [ d.long_name, d.id ] } %>
  <div class="card mb-3 <%= 'opacity-60' unless p.proposed? %>">
    <div class="flex justify-between text-sm mb-2">
      <span><span class="badge bg-stone-100"><%= p.status_label %><%= "(仕訳は取消)" if p.journal_entry&.cancelled? %></span><%= " 提案のし直し" if p.reproposed_from_id %> 確からしさ: <%= p.confidence_label %></span>
      <% if p.journal_entry %><%= link_to "記帳した仕訳（伝票 #{p.journal_entry.slip_number}）", p.journal_entry, class: "underline text-emerald-800" %><% end %>
    </div>
    <p class="text-sm text-stone-700 mb-3">理由: <%= p.rationale %></p>
    <% if p.proposed? %>
      <%= form_with model: p, url: journal_proposal_approval_path(p), method: :post do |f| %>
        <div class="grid md:grid-cols-4 gap-x-3 text-sm">
          <div class="field"><%= f.label :entry_date, "日付" %><%= f.date_field :entry_date %></div>
          <div class="field"><%= f.label :amount, "金額" %><%= f.number_field :amount %></div>
          <div class="field md:col-span-2"><%= f.label :summary, "摘要" %><%= f.text_field :summary %></div>
          <div class="field"><%= f.label :debit_account_id, "借方" %><%= f.select :debit_account_id, accounts, { include_blank: "(選んでください)" }, required: true %></div>
          <div class="field"><%= f.label :debit_department_id, "借方部門" %><%= f.select :debit_department_id, departments, include_blank: "（なし）" %></div>
          <div class="field"><%= f.label :credit_account_id, "貸方" %><%= f.select :credit_account_id, accounts, { include_blank: "(選んでください)" }, required: true %></div>
          <div class="field"><%= f.label :credit_department_id, "貸方部門" %><%= f.select :credit_department_id, departments, include_blank: "（なし）" %></div>
          <div class="field md:col-span-4"><%= f.label :sub_summary, "補助摘要" %><%= f.text_field :sub_summary %></div>
        </div>
        <div class="flex gap-2">
          <%= f.submit "この内容で承認して記帳", class: "btn" %>
        </div>
      <% end %>
      <%= button_to "却下", journal_proposal_rejection_path(p), class: "btn-danger mt-2" %>
    <% else %>
      <% e = p.journal_entry || p %><%# 承認したものは、人が直した内容(できた仕訳)を出す %>
      <p class="text-sm"><%= l e.entry_date %>　借方 <%= e.debit_account.display_name %><%= " / #{e.debit_department}" if e.debit_department %>　貸方 <%= e.credit_account.display_name %><%= " / #{e.credit_department}" if e.credit_department %>　<%= yen(e.amount) %> 円　<%= e.summary %>（<%= e.sub_summary %>）</p>
      <% if p.journal_entry&.cancelled? %>
        <% c = p.journal_entry.cancellation %>
        <p class="text-sm"><span class="nb-cancelled-tag">取消</span> <%= c.cancelled_at.strftime("%Y/%m/%d") %> <%= c.canceller&.name.presence || "—" %>: <%= c.reason %></p>
      <% elsif p.journal_entry&.cancellable? %>
        <div class="mt-2"><div class="text-sm font-medium mb-1">この仕訳を取り消す</div>
          <%= render "journal_entries/cancel_form", entry: p.journal_entry, back_to: "voucher" %>
          <p class="text-xs" style="color:var(--ink-muted);margin:4px 0 0">取り消すと、同じ提案の内容で「確認待ち」の提案をもう一度出します。正しい科目を選んで承認し直してください。元に戻せません。</p></div>
      <% end %>
    <% end %>
  </div>
<% end %>

<div class="flex gap-2 mt-6">
  <%= link_to "一覧へ", vouchers_path, class: "btn-secondary" %>
  <% unless @voucher.status.in?(%w[booked rejected]) %><%= button_to "記帳しない", reject_voucher_path(@voucher), class: "btn-danger" %><% end %>
  <% if (blocked = @voucher.destroy_blocked_reason) %>
    <%= disabled_action "削除", blocked %>
  <% else %>
    <%= button_to "削除", @voucher, method: :delete, class: "nb-btn nb-btn--danger", form: { data: { controller: "confirm-twice", action: "submit->confirm-twice#check" } }, data: { confirm_twice_target: "button", armed_label: "もう一度押すと、この証憑を削除します" } %>
  <% end %>
</div>
