<%# 住所・氏名の移り変わり(デザインシステム「住所・氏名の移り変わり」、見直し第20回、docs/adr/0029) %>
<section class="card md:col-span-2 nb-hist" id="person-history">
  <h2 class="section-title mt-0">住所・氏名の移り変わり</h2>
  <table class="nb-hist-table">
    <thead><tr><th>いつから</th><th>住所</th><th>氏名</th><th>記録</th><th></th></tr></thead>
    <tbody>
      <% person.history.each do |h| %>
        <% c = h.change %>
        <tr class="<%= 'is-cancelled' if c&.cancelled? %>">
          <td class="nb-num"><%= c ? c.date_label : "—" %></td>
          <td><%= h.address.presence || "—" %></td>
          <td><%= h.name %></td>
          <td>
            <% if c.nil? %><span class="nb-hist-mute">記録の始まり</span>
            <% else %>
              <span class="nb-tag nb-tag--plain"><%= h.kind == :address ? "住所の変更" : "改姓・改名" %></span>
              <% if c.cancelled? %><span class="nb-cancelled-tag">取消</span><div class="nb-hist-mute">取消 <%= c.cancellation.cancelled_at.strftime("%Y/%m/%d") %>: <%= c.cancellation.reason %></div><% end %>
              <% if (r = c.registration) %><div class="nb-hist-mute">登記: <%= r.done? ? "#{r.registered_on.strftime('%Y/%m/%d')} 登記した" : link_to("登記がいる(#{r.due_on ? "期限 #{r.due_on.strftime('%Y/%m/%d')}" : '期限は日が分かってから'})", registrations_path) %></div><% end %>
              <% if c.note.present? %><div class="nb-hist-mute"><%= c.note %></div><% end %>
            <% end %>
          </td>
          <td>
            <% latest = h.kind == :address ? person.latest_address_change : person.latest_name_change %>
            <% if c && c == latest && !Current.user&.auditor? && !c.registration&.registration_filing %>
              <%= form_with url: person_change_cancellation_path(person, change_type: h.kind, change_id: c.id), class: "nb-cancel-form", data: { controller: "confirm-twice", action: "submit->confirm-twice#check" } do %>
                <input name="reason" class="nb-input" placeholder="取り消す理由(打ち間違いなど)" required aria-label="取り消す理由">
                <button class="nb-btn nb-btn--danger" data-confirm-twice-target="button" data-armed-label="もう一度押すと取り消します">取り消す</button>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% unless Current.user&.auditor? %>
    <div class="nb-hist-actions">
      <details class="nb-hist-add">
        <summary class="nb-btn">住所が変わった</summary>
        <%= form_with url: person_address_changes_path(person), class: "nb-hist-form" do %>
          <label>新しい住所<input name="address" class="nb-input" required></label>
          <fieldset><legend>移った日(日が分からなければ空にする。推測で入れない)</legend>
            <input name="year" class="nb-input" inputmode="numeric" size="5" required aria-label="年">年
            <input name="month" class="nb-input" inputmode="numeric" size="3" required aria-label="月">月
            <input name="day" class="nb-input" inputmode="numeric" size="3" aria-label="日">日</fieldset>
          <label>メモ(出どころなど)<input name="note" class="nb-input"></label>
          <button class="nb-btn nb-btn--primary">記録する</button>
        <% end %>
      </details>
      <details class="nb-hist-add">
        <summary class="nb-btn">氏名が変わった</summary>
        <%= form_with url: person_name_changes_path(person), class: "nb-hist-form" do %>
          <label>新しい氏名(氏と名の間に空白)<input name="name" class="nb-input" required></label>
          <label>よみ<input name="name_kana" class="nb-input"></label>
          <fieldset><legend>変わった日(日が分からなければ空にする)</legend>
            <input name="year" class="nb-input" inputmode="numeric" size="5" required aria-label="年">年
            <input name="month" class="nb-input" inputmode="numeric" size="3" required aria-label="月">月
            <input name="day" class="nb-input" inputmode="numeric" size="3" aria-label="日">日</fieldset>
          <label class="nb-check"><input type="checkbox" name="show_former_name" value="1"> 旧氏を併記する(名簿・登記に「新しい氏名（旧氏 名）」と書く)</label>
          <label>メモ<input name="note" class="nb-input"></label>
          <button class="nb-btn nb-btn--primary">記録する</button>
        <% end %>
      </details>
    </div>
    <p class="nb-hist-mute">代表権のある理事(理事長・副理事長)の住所・氏名が変わると、「登記」に登記がいることが出ます(2 週間以内)。打ち間違いは、いちばん新しい出来事を取り消して入れ直します。</p>
  <% end %>
</section>
