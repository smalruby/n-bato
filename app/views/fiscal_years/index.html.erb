<% content_for :title, "会計" %>
<h1 class="page-title">会計</h1>
<div class="flex flex-wrap gap-2 mb-4">
  <%= link_to "残高照合", balance_checks_path, class: "btn-secondary" %>
  <%= link_to "会計王からの取り込み", siwake_imports_path, class: "btn-secondary" %>
  <%= link_to "科目と部門", accounts_path, class: "btn-secondary" %>
  <%= link_to "期首残高", opening_balances_path, class: "btn-secondary" %>
</div>
<%= render "fiscal_periods/start_next" %>
<div class="card">
  <% if @statements.empty? %>
    <p>仕訳がまだありません。<%= link_to "会計王の仕訳を取り込む", new_siwake_import_path, class: "underline" %></p>
  <% else %>
    <%= render "summary_table", statements: @statements %>
  <% end %>
</div>
