<% content_for :title, @fiscal_year.label %>
<h1 class="page-title"><%= @fiscal_year.label %>（<%= @fiscal_year.wareki_label %><% if (n = @organization.period_number(@fiscal_year)) %>・第<%= n %>期<% end %>）</h1>
<p class="text-stone-600 mb-4"><%= l @fiscal_year.starts_on %> 〜 <%= l @fiscal_year.ends_on %></p>
<%= render "fiscal_periods/state", period: FiscalPeriod.for(@fiscal_year.year) %>

<div class="grid md:grid-cols-4 gap-4 mb-6">
  <div class="card"><div class="text-sm text-stone-500">経常収益</div><div class="text-2xl num text-left"><%= yen(@statement.revenue_total) %></div></div>
  <div class="card"><div class="text-sm text-stone-500">経常費用</div><div class="text-2xl num text-left"><%= yen(@statement.expense_total) %></div></div>
  <div class="card"><div class="text-sm text-stone-500">正味財産の増減</div><div class="text-2xl num text-left"><%= yen(@statement.net_assets_change) %></div></div>
  <div class="card"><div class="text-sm text-stone-500">期末正味財産</div><div class="text-2xl num text-left"><%= yen(@statement.closing_net_assets) %></div></div>
</div>

<% unless @statement.balanced? %>
  <p class="mb-4 rounded bg-red-50 border border-red-200 px-4 py-2 text-red-900">活動計算書と貸借対照表が一致しません。期首残高と仕訳を確認してください。</p>
<% end %>

<div class="card mb-6">
  <h2 class="section-title mt-0">計算書類</h2>
  <ul class="flex flex-wrap gap-2">
    <% Ledger::Report::KINDS.each do |kind, label| %>
      <li class="flex gap-1">
        <%= link_to label, fiscal_year_statement_path(@fiscal_year.year, kind), class: "btn-secondary" %>
        <%= link_to "PDF", fiscal_year_statement_path(@fiscal_year.year, kind, format: :pdf), class: "btn-secondary" %>
      </li>
    <% end %>
  </ul>
  <p class="mt-3 text-sm"><%= link_to "総勘定元帳", fiscal_year_ledgers_path(@fiscal_year.year), class: "underline text-emerald-800 mr-4" %><%= link_to "この年度の仕訳を会計王の形式（SIWAKE）で書き出す", fiscal_year_siwake_export_path(@fiscal_year.year), class: "underline text-emerald-800" %></p>
</div>

<div class="grid md:grid-cols-2 gap-4">
  <div class="card">
    <h2 class="section-title mt-0">期末残高</h2>
    <table class="data-table">
      <% @statement.closing_balances.sort_by { |a, _| a.code }.each do |account, amount| %>
        <tr><td><%= account.display_name %></td><td class="num"><%= yen(amount) %></td></tr>
      <% end %>
    </table>
  </div>
  <div class="card">
    <h2 class="section-title mt-0">事業費の内訳</h2>
    <table class="data-table">
      <% @report.program_expense_breakdown.each do |dept, items| %>
        <% items.each do |account, amount| %>
          <tr><td><%= dept&.long_name || "区分なし" %></td><td><%= account.display_name %></td><td class="num"><%= yen(amount) %></td></tr>
        <% end %>
      <% end %>
    </table>
  </div>
</div>

<p class="mt-6"><%= link_to "この年度の仕訳を見る（#{@statement.entries.size} 件）", journal_entries_path(year: @fiscal_year.year), class: "underline text-emerald-800" %></p>
