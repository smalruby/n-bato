<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <title><%= @title %> <%= @fiscal_year&.label %></title>
    <style>
      @page { size: A4; margin: 20mm 18mm; }
      body { font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif CJK JP", "MS Mincho", serif; font-size: 10.5pt; line-height: 1.6; color: #000; background: #fff; margin: 0; }
      .sheet { max-width: 174mm; margin: 0 auto; padding: 8mm 0; }
      h1 { font-size: 14pt; text-align: center; margin: 0 0 .4em; }
      h2 { font-size: 11pt; margin: 1.2em 0 .4em; }
      h3 { font-size: 10.5pt; margin: .9em 0 .3em; }
      .period { text-align: center; margin: 0 0 .2em; }
      .org { text-align: right; margin: 0 0 1em; }
      table { border-collapse: collapse; width: 85%; margin: .4em auto .8em; font-size: 10pt; }
      th, td { border: 1px solid #000; padding: 2px 6px; line-height: 1.4; }
      th { background: #eee; font-weight: normal; }
      td.amount { text-align: right; white-space: nowrap; width: 28%; font-variant-numeric: tabular-nums; }
      tr.strong td { font-weight: bold; }
      .l1 { padding-left: 1.5em; } .l2 { padding-left: 3em; } .l3 { padding-left: 4.5em; }
      .toolbar { font-family: sans-serif; font-size: 10pt; text-align: right; padding: 6px; background: #f5f5f4; }
      .toolbar a { margin-left: 1em; }
      @media print { .toolbar { display: none; } .sheet { padding: 0; } }
    </style>
  </head>
  <body>
    <% unless @pdf %>
      <div class="toolbar">
        <% if @annual_report %>
          <%= link_to "← 事業報告書等に戻る", annual_report_path(@annual_report.fiscal_year) %>
        <% elsif @filing %>
          <%= link_to "← 登記の申請に戻る", registration_filing_path(@filing) %>
        <% elsif @fiscal_year %>
          <%= link_to "← 年度に戻る", fiscal_year_path(@fiscal_year.year) %>
        <% end %>
        <%= link_to "PDF", url_for(format: :pdf) %>
      </div>
    <% end %>
    <div class="sheet"><%= yield %></div>
  </body>
</html>
