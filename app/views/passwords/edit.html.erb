<% content_for :title, "パスワードを決め直す" %>
<%# パスワードを決め直す(デザインシステム SignIn と同じ枠)。メールのリンクから開く。 %>
<div class="nb-signin">
  <h1>パスワードを決め直す</h1>
  <p class="nb-signin-note">新しいパスワードを 2 回入れてください。決め直すと、ログインの画面に戻ります。</p>
  <%= form_with url: password_path(params[:token]), method: :put do |form| %>
    <label>新しいパスワード<%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72, class: "nb-input" %></label>
    <label>もう一度<%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "nb-input" %></label>
    <div class="nb-signin-row">
      <%= form.submit "パスワードを決め直す", class: "nb-btn nb-btn--primary" %>
      <%= link_to "ログインに戻る", new_session_path %>
    </div>
  <% end %>
</div>
