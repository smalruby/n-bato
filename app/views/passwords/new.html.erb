<% content_for :title, "パスワードを忘れたとき" %>
<%# パスワードを忘れたとき(デザインシステム SignIn と同じ枠)。登録があれば、再設定のリンクをメールで送る。 %>
<div class="nb-signin">
  <h1>パスワードを忘れたとき</h1>
  <p class="nb-signin-note">登録しているメールアドレスを入れてください。パスワードを決め直すリンクをメールで送ります(15 分のあいだ使えます)。パスキーを足してあれば、パスキーでもログインできます。</p>
  <%= form_with url: passwords_path do |form| %>
    <label>メールアドレス<%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "nb-input" %></label>
    <div class="nb-signin-row">
      <%= form.submit "再設定のリンクを送る", class: "nb-btn nb-btn--primary" %>
      <%= link_to "ログインに戻る", new_session_path %>
    </div>
  <% end %>
</div>
