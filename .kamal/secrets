# 本番の秘密。値は手元の秘密の置き場所($NBATO_SECRETS_DIR、chmod 600)から読む。
# ここには読み方だけを書く(場所も値もリポジトリに残さない)。
#
#   rails-master.key   config/master.key の写し
#   anthropic.env      ANTHROPIC_API_KEY=...
#   ses-smtp.env       SMTP_USERNAME=... / SMTP_PASSWORD=...(bin/infra-credentials keys が作る)
#   mail.env           NBATO_MAIL_FROM=...(SES で確かめたドメインのアドレス)

RAILS_MASTER_KEY=$(cat $NBATO_SECRETS_DIR/rails-master.key)
ANTHROPIC_API_KEY=$(sed -n 's/^ANTHROPIC_API_KEY=//p' $NBATO_SECRETS_DIR/anthropic.env)
SMTP_USERNAME=$(sed -n 's/^SMTP_USERNAME=//p' $NBATO_SECRETS_DIR/ses-smtp.env)
SMTP_PASSWORD=$(sed -n 's/^SMTP_PASSWORD=//p' $NBATO_SECRETS_DIR/ses-smtp.env)
NBATO_MAIL_FROM=$(sed -n 's/^NBATO_MAIL_FROM=//p' $NBATO_SECRETS_DIR/mail.env)
