# 本番の秘密。ここには読み方だけを書く(場所も値もリポジトリに残さない)。docs/deploy.md
#
# 値は bin/kamal-secret が出す。同じ名前の環境変数があればそれを(GitHub Actions の Deploy)、
# 無ければ手元の秘密の置き場所($NBATO_SECRETS_DIR、chmod 600)のファイルを読む(Mac から)。
#
#   rails-master.key   config/master.key の写し
#   n-bato-deploy      サーバーに入る SSH の秘密鍵(Mac 用。Actions は別の鍵)
#   anthropic.env      ANTHROPIC_API_KEY=...
#   ses-smtp.env       SMTP_USERNAME=... / SMTP_PASSWORD=...(bin/infra-credentials keys が作る)
#   mail.env           NBATO_MAIL_FROM=...(SES で確かめたドメインのアドレス)
#   aws-backup.env     NBATO_BACKUP_BUCKET=... / NBATO_BACKUP_AWS_*(bin/infra-credentials keys が作る)
#
# KAMAL_REGISTRY_USERNAME / KAMAL_REGISTRY_PASSWORD(ghcr.io)は環境変数だけ。Actions はジョブの GITHUB_TOKEN。
# Mac は持たない(開発QAボード 第9回 r9-ghcr)。無ければ空になり、トークンの要る操作は .kamal/hooks/pre-connect が止める。

RAILS_MASTER_KEY=$(bin/kamal-secret RAILS_MASTER_KEY)
ANTHROPIC_API_KEY=$(bin/kamal-secret ANTHROPIC_API_KEY)
SMTP_USERNAME=$(bin/kamal-secret SMTP_USERNAME)
SMTP_PASSWORD=$(bin/kamal-secret SMTP_PASSWORD)
NBATO_MAIL_FROM=$(bin/kamal-secret NBATO_MAIL_FROM)
NBATO_BACKUP_BUCKET=$(bin/kamal-secret NBATO_BACKUP_BUCKET)
NBATO_BACKUP_AWS_ACCESS_KEY_ID=$(bin/kamal-secret NBATO_BACKUP_AWS_ACCESS_KEY_ID)
NBATO_BACKUP_AWS_SECRET_ACCESS_KEY=$(bin/kamal-secret NBATO_BACKUP_AWS_SECRET_ACCESS_KEY)
NBATO_SSH_PRIVATE_KEY=$(bin/kamal-secret NBATO_SSH_PRIVATE_KEY)
KAMAL_REGISTRY_USERNAME=$(bin/kamal-secret KAMAL_REGISTRY_USERNAME)
KAMAL_REGISTRY_PASSWORD=$(bin/kamal-secret KAMAL_REGISTRY_PASSWORD)
