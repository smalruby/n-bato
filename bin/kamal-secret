#!/usr/bin/env bash
# Kamal の秘密を 1 つ出す(.kamal/secrets から呼ぶ。人が直接使うものではない)。
#
#   bin/kamal-secret RAILS_MASTER_KEY
#
# 読む順番(docs/adr/0036、docs/deploy.md):
#   1. 同じ名前の環境変数があれば、それ(GitHub Actions: Environment「production」の Secrets を env で渡す)
#   2. 無ければ、手元の秘密の置き場所 $NBATO_SECRETS_DIR のファイル(Mac からのデプロイ・運用)
#
# 名前とファイルの対応は、この表だけに書く。値は標準出力にだけ出し、エラーには名前しか書かない。
set -euo pipefail

name="${1:?秘密の名前を指定してください}"

# 名前 → 置き場所のファイル(「-」はファイルの中身全部、それ以外は「名前=値」の行)
case "$name" in
  RAILS_MASTER_KEY)                   file=rails-master.key; whole=1 ;;
  NBATO_SSH_PRIVATE_KEY)              file=n-bato-deploy;    whole=1 ;;
  ANTHROPIC_API_KEY)                  file=anthropic.env ;;
  SMTP_USERNAME|SMTP_PASSWORD)        file=ses-smtp.env ;;
  NBATO_MAIL_FROM)                    file=mail.env ;;
  NBATO_BACKUP_BUCKET|NBATO_BACKUP_AWS_ACCESS_KEY_ID|NBATO_BACKUP_AWS_SECRET_ACCESS_KEY)
                                      file=aws-backup.env ;;
  KAMAL_REGISTRY_USERNAME|KAMAL_REGISTRY_PASSWORD)
                                      file=ghcr.env ;;
  *) echo "bin/kamal-secret: 知らない名前です: $name" >&2; exit 1 ;;
esac

if [ -n "${!name:-}" ]; then
  printf '%s' "${!name}"
  exit 0
fi

if [ -z "${NBATO_SECRETS_DIR:-}" ]; then
  echo "bin/kamal-secret: $name がありません。環境変数で渡すか、NBATO_SECRETS_DIR に秘密の置き場所を入れてください" >&2
  exit 1
fi

path="$NBATO_SECRETS_DIR/$file"
if [ ! -r "$path" ]; then
  echo "bin/kamal-secret: $name の置き場所 \$NBATO_SECRETS_DIR/$file が読めません" >&2
  exit 1
fi

if [ -n "${whole:-}" ]; then
  cat "$path"
else
  value="$(sed -n "s/^${name}=//p" "$path")"
  if [ -z "$value" ]; then
    echo "bin/kamal-secret: \$NBATO_SECRETS_DIR/$file に $name= の行がありません" >&2
    exit 1
  fi
  printf '%s' "$value"
fi
