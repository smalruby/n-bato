#!/usr/bin/env ruby
# 本番の AWS の秘密を作って、手元の秘密の置き場所($NBATO_SECRETS_DIR)に置く。
# スタック(infra/)には秘密を入れない決まり(デプロイの相談 第3回)なので、ここで作る。
#
#   NBATO_SECRETS_DIR=... AWS_PROFILE=... bin/infra-credentials keypair   # cdk deploy の前: SSH の公開鍵を Lightsail に登録
#   NBATO_SECRETS_DIR=... AWS_PROFILE=... bin/infra-credentials keys      # cdk deploy の後: アクセスキーと SES の SMTP のパスワード
#
# すでにあるもの(登録済みの鍵・保存済みのファイル)は作り直さない。
require "json"
require "open3"
require "openssl"
require "base64"
require "fileutils"

REGION = "ap-northeast-1"
STACK = "NBatoStack"
KEY_PAIR_NAME = "n-bato-deploy"

dir = ENV["NBATO_SECRETS_DIR"] or abort "NBATO_SECRETS_DIR に秘密の置き場所を入れてください"
abort "#{dir} がありません" unless File.directory?(dir)

def aws(*args)
  out, err, st = Open3.capture3("aws", *args, "--region", REGION, "--output", "json")
  abort "aws #{args.first(2).join(' ')} に失敗しました: #{err}" unless st.success?
  out.empty? ? {} : JSON.parse(out)
end

def write_secret(path, body)
  File.write(path, body)
  File.chmod(0o600, path)
  puts "保存しました: #{path}"
end

def outputs
  stack = aws("cloudformation", "describe-stacks", "--stack-name", STACK)["Stacks"].first
  stack["Outputs"].to_h { |o| [ o["OutputKey"], o["OutputValue"] ] }
end

# SES の SMTP のパスワードは、IAM のシークレットキーから決まった手順で作る(AWS の SES の文書の「SMTP 認証情報の取得」)。
def ses_smtp_password(secret_key)
  sig = [ "11111111", REGION, "ses", "aws4_request", "SendRawEmail" ].reduce("AWS4#{secret_key}") do |key, msg|
    OpenSSL::HMAC.digest("SHA256", key, msg)
  end
  Base64.strict_encode64([ 4 ].pack("C") + sig)
end

def create_access_key(user)
  aws("iam", "create-access-key", "--user-name", user)["AccessKey"]
end

case ARGV.first
when "keypair"
  pub = File.join(dir, "#{KEY_PAIR_NAME}.pub")
  abort "#{pub} がありません" unless File.exist?(pub)
  names = aws("lightsail", "get-key-pairs")["keyPairs"].map { |k| k["name"] }
  if names.include?(KEY_PAIR_NAME)
    puts "Lightsail に #{KEY_PAIR_NAME} は登録済みです"
  else
    aws("lightsail", "import-key-pair", "--key-pair-name", KEY_PAIR_NAME, "--public-key-base64", File.read(pub).strip)
    puts "Lightsail に #{KEY_PAIR_NAME} を登録しました"
  end
when "keys"
  out = outputs
  backup = File.join(dir, "aws-backup.env")
  if File.exist?(backup)
    puts "#{backup} はあります"
  else
    k = create_access_key(out.fetch("BackupUserName"))
    write_secret(backup, <<~ENV)
      NBATO_BACKUP_BUCKET=#{out.fetch("BackupBucketName")}
      NBATO_BACKUP_AWS_ACCESS_KEY_ID=#{k["AccessKeyId"]}
      NBATO_BACKUP_AWS_SECRET_ACCESS_KEY=#{k["SecretAccessKey"]}
    ENV
  end
  smtp = File.join(dir, "ses-smtp.env")
  if File.exist?(smtp)
    puts "#{smtp} はあります"
  else
    k = create_access_key(out.fetch("MailUserName"))
    write_secret(smtp, <<~ENV)
      SMTP_ADDRESS=email-smtp.#{REGION}.amazonaws.com
      SMTP_USERNAME=#{k["AccessKeyId"]}
      SMTP_PASSWORD=#{ses_smtp_password(k["SecretAccessKey"])}
    ENV
  end
else
  abort "使い方: bin/infra-credentials keypair|keys"
end
